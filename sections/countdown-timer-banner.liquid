{{ 'component-sections.css' | asset_url | stylesheet_tag }}

<section class="countdown-banner" aria-label="Sale countdown timer">
  <div class="container">
    <div class="countdown-wrapper">
      <div class="countdown-timer" data-countdown-target="{{ section.settings.countdown_date }}">
        <div class="countdown-unit">
          <div class="countdown-value">
            <span data-countdown-days>{{ section.settings.days_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.days_label }}</span>
        </div>
        <span class="countdown-separator">:</span>
        <div class="countdown-unit">
          <div class="countdown-value">
            <span data-countdown-hours>{{ section.settings.hours_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.hours_label }}</span>
        </div>
        <span class="countdown-separator">:</span>
        <div class="countdown-unit">
          <div class="countdown-value">
            <span data-countdown-minutes>{{ section.settings.minutes_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.minutes_label }}</span>
        </div>
        <span class="countdown-separator">:</span>
        <div class="countdown-unit">
          <div class="countdown-value">
            <span data-countdown-seconds>{{ section.settings.seconds_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.seconds_label }}</span>
        </div>
      </div>

      {% if section.settings.show_promo_text %}
        <div class="countdown-promo-text">
          <span style="color: {{ section.settings.promo_text_color }}; font-size: {{ section.settings.promo_text_size }}px; font-weight: {{ section.settings.promo_text_weight }};">
            {{ section.settings.promo_text }}
          </span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const countdownTimers = document.querySelectorAll('[data-countdown-target]');

    countdownTimers.forEach(function(timer) {
      const targetDate = new Date(timer.dataset.countdownTarget).getTime();
      const daysEl = timer.querySelector('[data-countdown-days]');
      const hoursEl = timer.querySelector('[data-countdown-hours]');
      const minutesEl = timer.querySelector('[data-countdown-minutes]');
      const secondsEl = timer.querySelector('[data-countdown-seconds]');

      function updateCountdown() {
        const now = new Date().getTime();
        const distance = targetDate - now;

        if (distance > 0) {
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
          if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
        }
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    });
  });
</script>

{% schema %}
{
  "name": "Countdown Timer Banner",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    {
      "type": "header",
      "content": "Countdown Settings"
    },
    {
      "type": "text",
      "id": "countdown_date",
      "label": "Countdown End Date",
      "info": "Format: YYYY-MM-DD HH:MM:SS",
      "default": "2025-02-14 23:59:59"
    },
    {
      "type": "header",
      "content": "Fallback Values (if JS disabled)"
    },
    {
      "type": "text",
      "id": "days_fallback",
      "label": "Days",
      "default": "10"
    },
    {
      "type": "text",
      "id": "hours_fallback",
      "label": "Hours",
      "default": "08"
    },
    {
      "type": "text",
      "id": "minutes_fallback",
      "label": "Minutes",
      "default": "50"
    },
    {
      "type": "text",
      "id": "seconds_fallback",
      "label": "Seconds",
      "default": "00"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "days_label",
      "label": "Days Label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Hours Label",
      "default": "Hrs"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Minutes Label",
      "default": "Min"
    },
    {
      "type": "text",
      "id": "seconds_label",
      "label": "Seconds Label",
      "default": "Sec"
    },
    {
      "type": "header",
      "content": "Promotional Text"
    },
    {
      "type": "checkbox",
      "id": "show_promo_text",
      "label": "Show Promotional Text",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promotional Text",
      "default": "Valentine's Sale - 25% OFF"
    },
    {
      "type": "color",
      "id": "promo_text_color",
      "label": "Promo Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "promo_text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Promo Text Size",
      "default": 14
    },
    {
      "type": "select",
      "id": "promo_text_weight",
      "label": "Promo Text Weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0F172A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer Banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
