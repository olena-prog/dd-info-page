<section class="countdown-banner-section" style="background-color: {{ section.settings.background_color }}; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
  <div class="countdown-banner-container">
    <div class="countdown-banner-content">
      {%- comment -%} Timer Section {%- endcomment -%}
      <div class="countdown-timer-wrapper" data-countdown-target="{{ section.settings.countdown_date }}">
        <div class="countdown-unit">
          <div class="countdown-value-box">
            <span class="countdown-number" data-countdown-days>{{ section.settings.days_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.days_label }}</span>
        </div>
        <span class="countdown-colon">:</span>
        <div class="countdown-unit">
          <div class="countdown-value-box">
            <span class="countdown-number" data-countdown-hours>{{ section.settings.hours_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.hours_label }}</span>
        </div>
        <span class="countdown-colon">:</span>
        <div class="countdown-unit">
          <div class="countdown-value-box">
            <span class="countdown-number" data-countdown-minutes>{{ section.settings.minutes_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.minutes_label }}</span>
        </div>
        <span class="countdown-colon">:</span>
        <div class="countdown-unit">
          <div class="countdown-value-box">
            <span class="countdown-number" data-countdown-seconds>{{ section.settings.seconds_fallback }}</span>
          </div>
          <span class="countdown-label">{{ section.settings.seconds_label }}</span>
        </div>
      </div>

      {%- comment -%} Promo Text {%- endcomment -%}
      {% if section.settings.show_promo_text %}
        <div class="countdown-promo">
          <span class="countdown-promo-text">{{ section.settings.promo_text }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .countdown-banner-section {
    padding: 0.5rem 0;
  }

  @media (min-width: 768px) {
    .countdown-banner-section {
      padding: 0.625rem 0;
    }
  }

  .countdown-banner-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .countdown-banner-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .countdown-banner-content {
      flex-direction: row;
      gap: 1.5rem;
    }
  }

  .countdown-timer-wrapper {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  @media (min-width: 768px) {
    .countdown-timer-wrapper {
      gap: 0.5rem;
    }
  }

  .countdown-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .countdown-value-box {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    padding: 0.375rem 0.5rem;
    min-width: 2.25rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .countdown-value-box {
      padding: 0.5rem 0.75rem;
      min-width: 2.75rem;
    }
  }

  .countdown-number {
    font-size: 0.875rem;
    font-weight: 700;
    color: #FFFFFF;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 768px) {
    .countdown-number {
      font-size: 1rem;
    }
  }

  .countdown-label {
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .countdown-colon {
    color: rgba(255, 255, 255, 0.4);
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0.125rem;
    align-self: flex-start;
    padding-top: 0.5rem;
  }

  .countdown-promo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .countdown-promo-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: 0.025em;
  }

  @media (min-width: 768px) {
    .countdown-promo-text {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const timers = document.querySelectorAll('[data-countdown-target]');

    timers.forEach(function(timer) {
      const targetDate = new Date(timer.dataset.countdownTarget).getTime();
      const daysEl = timer.querySelector('[data-countdown-days]');
      const hoursEl = timer.querySelector('[data-countdown-hours]');
      const minutesEl = timer.querySelector('[data-countdown-minutes]');
      const secondsEl = timer.querySelector('[data-countdown-seconds]');

      function updateCountdown() {
        const now = new Date().getTime();
        const distance = targetDate - now;

        if (distance > 0) {
          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hours).padStart(2, '0');
          if (minutesEl) minutesEl.textContent = String(minutes).padStart(2, '0');
          if (secondsEl) secondsEl.textContent = String(seconds).padStart(2, '0');
        }
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);
    });
  });
</script>

