{{ 'base.css' | asset_url | stylesheet_tag }}

<section class="product-bg-section">
  {%- comment -%} Background Images {%- endcomment -%}
  <div class="product-bg-images">
    {%- comment -%} Mobile Background {%- endcomment -%}
    <div class="product-bg-mobile">
      {% if section.settings.mobile_image != blank %}
        <img
          src="{{ section.settings.mobile_image | image_url: width: 800 }}"
          srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w,
                  {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
                  {{ section.settings.mobile_image | image_url: width: 800 }} 800w"
          sizes="100vw"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
          alt="{{ section.settings.mobile_image.alt | default: section.settings.title_line_1 }}"
          loading="lazy"
          class="product-bg-img"
        >
      {% else %}
        <div class="product-bg-placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span>Upload Mobile Product Image</span>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Desktop Background {%- endcomment -%}
    <div class="product-bg-desktop">
      {% if section.settings.desktop_image != blank %}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 1920 }}"
          srcset="{{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
                  {{ section.settings.desktop_image | image_url: width: 1600 }} 1600w,
                  {{ section.settings.desktop_image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="{{ section.settings.desktop_image.width }}"
          height="{{ section.settings.desktop_image.height }}"
          alt="{{ section.settings.desktop_image.alt | default: section.settings.title_line_1 }}"
          loading="lazy"
          class="product-bg-img"
        >
      {% else %}
        <div class="product-bg-placeholder">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <span>Upload Desktop Product Image (1920x600px)</span>
        </div>
      {% endif %}
    </div>

    <div class="product-bg-overlay"></div>
  </div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="product-bg-content-wrapper">
    <div class="product-bg-container">
      <div class="product-bg-content">
        {%- comment -%} Title {%- endcomment -%}
        <h3 class="product-bg-title">
          <span class="product-bg-title-line1">{{ section.settings.title_line_1 }}</span>
          <span class="product-bg-title-line2">{{ section.settings.title_line_2 }}</span>
        </h3>

        {%- comment -%} Features List {%- endcomment -%}
        <div class="product-bg-features">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
              <div class="product-bg-feature" {{ block.shopify_attributes }}>
                <div class="product-bg-feature-icon">
                  {% case block.settings.icon %}
                    {% when 'zap' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                    {% when 'timer' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
                    {% when 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                    {% when 'sparkles' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
                  {% endcase %}
                </div>
                <span>{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>

        {%- comment -%} Buttons {%- endcomment -%}
        <div class="product-bg-buttons">
          {% if section.settings.primary_button_text != blank %}
            <a href="{{ section.settings.primary_button_url }}"
               {% if section.settings.primary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
               class="product-bg-btn product-bg-btn-primary">
              {{ section.settings.primary_button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          {% endif %}

          {% if section.settings.secondary_button_text != blank %}
            <a href="{{ section.settings.secondary_button_url }}"
               {% if section.settings.secondary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
               class="product-bg-btn product-bg-btn-amazon">
              {{ section.settings.secondary_button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .product-bg-section {
    position: relative;
    min-height: 450px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .product-bg-section {
      min-height: 500px;
    }
  }

  /* Background Images */
  .product-bg-images {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .product-bg-mobile {
    display: block;
    position: absolute;
    inset: 0;
  }

  .product-bg-desktop {
    display: none;
    position: absolute;
    inset: 0;
  }

  @media (min-width: 768px) {
    .product-bg-mobile {
      display: none;
    }
    .product-bg-desktop {
      display: block;
    }
  }

  .product-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .product-bg-placeholder {
    width: 100%;
    height: 100%;
    min-height: 450px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: linear-gradient(135deg, #1a1a2e, #16213e);
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.875rem;
  }

  .product-bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(15, 23, 42, 0.9), rgba(15, 23, 42, 0.7), rgba(15, 23, 42, 0.3));
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .product-bg-overlay {
      background: linear-gradient(to right, rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.5), transparent);
    }
  }

  /* Content Wrapper */
  .product-bg-content-wrapper {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    min-height: 450px;
    padding: 3rem 0;
  }

  @media (min-width: 768px) {
    .product-bg-content-wrapper {
      min-height: 500px;
    }
  }

  .product-bg-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .product-bg-container {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .product-bg-container {
      padding: 0 2rem;
    }
  }

  .product-bg-content {
    max-width: 500px;
  }

  /* Title */
  .product-bg-title {
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .product-bg-title-line1 {
    display: block;
    font-size: 1.5rem;
    font-weight: 900;
    color: #FFFFFF;
  }

  .product-bg-title-line2 {
    display: block;
    font-size: 1.75rem;
    font-weight: 900;
    color: #3B82F6;
  }

  @media (min-width: 768px) {
    .product-bg-title-line1 {
      font-size: 1.875rem;
    }
    .product-bg-title-line2 {
      font-size: 2.25rem;
    }
  }

  /* Features */
  .product-bg-features {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .product-bg-feature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.875rem;
  }

  .product-bg-feature-icon {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(59, 130, 246, 0.2);
    border-radius: 0.375rem;
    color: #60A5FA;
  }

  /* Buttons */
  .product-bg-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .product-bg-buttons {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  .product-bg-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
    width: 100%;
  }

  @media (min-width: 640px) {
    .product-bg-btn {
      width: auto;
    }
  }

  .product-bg-btn svg {
    transition: transform 0.2s ease;
  }

  .product-bg-btn:hover svg {
    transform: translateX(4px);
  }

  .product-bg-btn-primary {
    background: #3B82F6;
    color: #FFFFFF;
    box-shadow: 0 0 20px rgba(59, 130, 246, 0.4);
  }

  .product-bg-btn-primary:hover {
    background: #2563EB;
    transform: scale(1.02);
  }

  .product-bg-btn-amazon {
    background: #FF9900;
    color: #000000;
  }

  .product-bg-btn-amazon:hover {
    background: #e88a00;
    transform: scale(1.02);
  }
</style>

{% schema %}
{
  "name": "Product Background",
  "tag": "section",
  "class": "section-product-bg",
  "settings": [
    {
      "type": "header",
      "content": "Background Images"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image",
      "info": "Recommended: 800x800px"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Background Image",
      "info": "Recommended: 1920x600px"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Tried Everything?"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Highlighted)",
      "default": "Try What Works."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Button Text",
      "default": "Shop Valentine's Sale – 25% OFF"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "primary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Button Text",
      "default": "Shop on Amazon"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "secondary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "zap", "label": "Zap/Lightning" },
            { "value": "timer", "label": "Timer" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkles", "label": "Sparkles" }
          ],
          "default": "zap"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "13% Lidocaine for fast action"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Background",
      "category": "Image",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "zap",
            "text": "13% Lidocaine for fast action"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "timer",
            "text": "Works within minutes"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "text": "Clinically Tested Formula"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "sparkles",
            "text": "No Transfer to Partner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
