{{ 'component-sections.css' | asset_url | stylesheet_tag }}

<section class="product-bg-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {%- comment -%} Background Images {%- endcomment -%}
  <div class="product-bg-image">
    {%- comment -%} Mobile Background {%- endcomment -%}
    <div class="product-bg-image-mobile">
      {% if section.settings.mobile_image != blank %}
        <img
          src="{{ section.settings.mobile_image | image_url: width: 800 }}"
          srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w,
                  {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
                  {{ section.settings.mobile_image | image_url: width: 800 }} 800w"
          sizes="100vw"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
          alt="{{ section.settings.mobile_image.alt | default: section.settings.title }}"
          loading="lazy"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      {% else %}
        <div class="image-upload-placeholder" style="height: 400px; background-color: #1a1a2e;">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(255,255,255,0.3);"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <p style="color: rgba(255,255,255,0.4); font-size: 12px; margin-top: 8px;">Upload Mobile Product Background</p>
        </div>
      {% endif %}
    </div>

    {%- comment -%} Desktop Background {%- endcomment -%}
    <div class="product-bg-image-desktop">
      {% if section.settings.desktop_image != blank %}
        <img
          src="{{ section.settings.desktop_image | image_url: width: 1920 }}"
          srcset="{{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
                  {{ section.settings.desktop_image | image_url: width: 1600 }} 1600w,
                  {{ section.settings.desktop_image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          width="{{ section.settings.desktop_image.width }}"
          height="{{ section.settings.desktop_image.height }}"
          alt="{{ section.settings.desktop_image.alt | default: section.settings.title }}"
          loading="lazy"
          style="width: 100%; height: 100%; object-fit: cover;"
        >
      {% else %}
        <div class="image-upload-placeholder" style="height: 500px; background-color: #1a1a2e;">
          <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: rgba(255,255,255,0.3);"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <p style="color: rgba(255,255,255,0.4); font-size: 14px; margin-top: 12px;">Upload Desktop Product Background (Recommended: 1920x600px)</p>
        </div>
      {% endif %}
    </div>

    <div class="product-bg-overlay" style="background: {{ section.settings.overlay_gradient }};"></div>
  </div>

  <div class="container relative z-10">
    <div class="product-bg-content" style="max-width: {{ section.settings.content_width }}px;">
      {%- comment -%} Title {%- endcomment -%}
      <h3 class="product-bg-title">
        {{ section.settings.title_line_1 }}<br>
        <span>{{ section.settings.title_line_2 }}</span>
      </h3>

      {%- comment -%} Features List {%- endcomment -%}
      <div class="product-features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="product-feature" {{ block.shopify_attributes }}>
              {% case block.settings.icon %}
                {% when 'zap' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                {% when 'timer' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="10" x2="14" y1="2" y2="2"/><line x1="12" x2="15" y1="14" y2="11"/><circle cx="12" cy="14" r="8"/></svg>
                {% when 'shield' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                {% when 'sparkles' %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
              {% endcase %}
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} Buttons {%- endcomment -%}
      <div class="flex flex-col gap-2" style="margin-bottom: 0.5rem;">
        {% if section.settings.primary_button_text != blank %}
          <a href="{{ section.settings.primary_button_url }}"
             {% if section.settings.primary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
             class="btn btn-primary btn-lg btn-full">
            {{ section.settings.primary_button_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_text != blank %}
          <a href="{{ section.settings.secondary_button_url }}"
             {% if section.settings.secondary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
             class="btn btn-amazon btn-lg btn-full">
            {{ section.settings.secondary_button_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Background",
  "tag": "section",
  "class": "section-product-bg",
  "settings": [
    {
      "type": "header",
      "content": "Background Images"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image",
      "info": "Recommended: 800x800px"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Background Image",
      "info": "Recommended: 1920x600px"
    },
    {
      "type": "text",
      "id": "overlay_gradient",
      "label": "Overlay Gradient CSS",
      "default": "linear-gradient(to right, rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.6), transparent)"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Tried Everything?"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2 (Highlighted)",
      "default": "Try What Works."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Button Text",
      "default": "Shop Valentine's Sale – 25% OFF"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "primary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Button Text",
      "default": "Shop on Amazon"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "secondary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 300,
      "max": 600,
      "step": 25,
      "unit": "px",
      "label": "Content Max Width",
      "default": 500
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 65
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "zap", "label": "Zap/Lightning" },
            { "value": "timer", "label": "Timer" },
            { "value": "shield", "label": "Shield" },
            { "value": "sparkles", "label": "Sparkles" }
          ],
          "default": "zap"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "13% Lidocaine for fast action"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Background",
      "category": "Image",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "zap",
            "text": "13% Lidocaine for fast action"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "timer",
            "text": "Works within minutes"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "text": "Clinically Tested Formula"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "sparkles",
            "text": "No Transfer to Partner"
          }
        }
      ]
    }
  ]
}
{% endschema %}
