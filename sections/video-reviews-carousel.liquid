{{ 'base.css' | asset_url | stylesheet_tag }}

<section class="reviews-section" style="background-color: {{ section.settings.background_color }};">
  <div class="reviews-container">
    {%- comment -%} Header {%- endcomment -%}
    <div class="reviews-header">
      <h2 class="reviews-title">{{ section.settings.title }}</h2>
      <p class="reviews-subtitle">{{ section.settings.subtitle }}</p>
      <div class="reviews-rating">
        <div class="reviews-stars">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
          {% endfor %}
        </div>
        <span class="reviews-rating-value">{{ section.settings.rating }}</span>
        <span class="reviews-rating-count">({{ section.settings.review_count }})</span>
      </div>
    </div>

    {%- comment -%} Carousel {%- endcomment -%}
    <div class="reviews-carousel-wrapper">
      <div class="reviews-carousel" id="reviews-track">
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <div class="review-card" {{ block.shopify_attributes }}>
              <div class="review-media">
                {% if block.settings.video != blank %}
                  <video
                    src="{{ block.settings.video.sources[0].url }}"
                    loop playsinline muted autoplay
                    loading="lazy"
                    class="review-video"
                  ></video>
                {% elsif block.settings.video_url != blank %}
                  <video
                    src="{{ block.settings.video_url }}"
                    loop playsinline muted autoplay
                    loading="lazy"
                    class="review-video"
                  ></video>
                {% elsif block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                            {{ block.settings.image | image_url: width: 400 }} 400w"
                    sizes="280px"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    alt="{{ block.settings.image.alt | default: 'Customer Review' }}"
                    loading="lazy"
                    class="review-img"
                  >
                {% else %}
                  <div class="review-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
                    <span>Upload Video/Image</span>
                  </div>
                {% endif %}
              </div>
              <div class="review-content">
                <div class="review-card-stars">
                  {% for i in (1..5) %}
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#F59E0B" stroke="#F59E0B" stroke-width="1"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/></svg>
                  {% endfor %}
                </div>
                <p class="review-text">"{{ block.settings.review_text }}"</p>
                {% if block.settings.show_verified %}
                  <div class="review-verified">
                    <span class="review-verified-check">✓</span>
                    <span>{{ section.settings.verified_text }}</span>
                  </div>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} Navigation {%- endcomment -%}
      <button class="reviews-nav-btn reviews-nav-prev" onclick="scrollReviews(-1)" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button class="reviews-nav-btn reviews-nav-next" onclick="scrollReviews(1)" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 3rem 1rem;
  }

  @media (min-width: 768px) {
    .reviews-section {
      padding: 4rem 1.5rem;
    }
  }

  .reviews-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .reviews-title {
    font-size: 1.75rem;
    font-weight: 900;
    color: #0F172A;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 768px) {
    .reviews-title {
      font-size: 2.25rem;
    }
  }

  .reviews-subtitle {
    font-size: 0.938rem;
    color: #64748B;
    margin-bottom: 1rem;
  }

  .reviews-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .reviews-stars {
    display: flex;
    gap: 0.125rem;
  }

  .reviews-rating-value {
    font-size: 1rem;
    font-weight: 700;
    color: #0F172A;
  }

  .reviews-rating-count {
    font-size: 0.875rem;
    color: #64748B;
  }

  /* Carousel */
  .reviews-carousel-wrapper {
    position: relative;
  }

  .reviews-carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.5rem 0;
  }

  .reviews-carousel::-webkit-scrollbar {
    display: none;
  }

  .review-card {
    flex: 0 0 280px;
    scroll-snap-align: start;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 1rem;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .review-card:hover {
    border-color: #3B82F6;
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.15);
  }

  .review-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #F1F5F9;
  }

  .review-video,
  .review-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .review-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #94A3B8;
    font-size: 0.75rem;
  }

  .review-content {
    padding: 1rem;
  }

  .review-card-stars {
    display: flex;
    gap: 0.125rem;
    margin-bottom: 0.5rem;
  }

  .review-text {
    font-size: 0.813rem;
    color: #475569;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review-verified {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.688rem;
    color: #22C55E;
  }

  .review-verified-check {
    width: 1rem;
    height: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(34, 197, 94, 0.1);
    border-radius: 50%;
    font-size: 0.625rem;
  }

  /* Navigation */
  .reviews-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.2s ease;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .reviews-nav-btn:hover {
    background: #3B82F6;
    border-color: #3B82F6;
    color: #FFFFFF;
  }

  .reviews-nav-prev {
    left: -0.5rem;
  }

  .reviews-nav-next {
    right: -0.5rem;
  }

  @media (max-width: 640px) {
    .reviews-nav-btn {
      display: none;
    }
  }
</style>

<script>
  function scrollReviews(direction) {
    const track = document.getElementById('reviews-track');
    if (track) {
      const scrollAmount = 296;
      track.scrollBy({ left: direction * scrollAmount, behavior: 'smooth' });
    }
  }
</script>

{% schema %}
{
  "name": "Video Reviews Carousel",
  "tag": "section",
  "class": "section-reviews",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Real People. Real Results."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Trusted by thousands worldwide"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Average Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "49,847+ reviews"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified Badge Text",
      "default": "Verified Purchase"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#EFF6FF"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Video Review",
      "settings": [
        {
          "type": "header",
          "content": "Video/Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Review Video",
          "info": "Upload MP4 video (4:5 aspect ratio)"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "External Video URL",
          "info": "Or enter external MP4 URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image",
          "info": "4:5 aspect ratio recommended"
        },
        {
          "type": "header",
          "content": "Review Content"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "This product really works! My confidence has improved so much."
        },
        {
          "type": "checkbox",
          "id": "show_verified",
          "label": "Show Verified Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Reviews Carousel",
      "category": "Testimonials",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review_text": "I bought this for my boyfriend because he always got nervous about finishing too fast. It actually helped a lot!",
            "show_verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "I was skeptical but wow. It didn't numb anything, it just slowed things down enough. Big difference.",
            "show_verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "We tried the spray together and it became part of our routine. Easy and makes our time feel more connected.",
            "show_verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
