{{ 'component-sections.css' | asset_url | stylesheet_tag }}

<section class="how-it-works-section section-bg-pattern" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};">
  <div class="container">
    <div class="hiw-content">
      {%- comment -%} Header {%- endcomment -%}
      <div class="hiw-header">
        <h2 class="hiw-title font-black">{{ section.settings.title }}</h2>
        {% if section.settings.subtitle != blank %}
          <div class="hiw-subtitle">
            <p>{{ section.settings.subtitle }}</p>
          </div>
        {% endif %}
      </div>

      {%- comment -%} Main Feature Card with Image {%- endcomment -%}
      <div class="hiw-main-card">
        <div class="hiw-main-card-content">
          {%- comment -%} Image Container {%- endcomment -%}
          <div class="hiw-image-container">
            {% if section.settings.feature_image != blank %}
              <img
                src="{{ section.settings.feature_image | image_url: width: 400 }}"
                srcset="{{ section.settings.feature_image | image_url: width: 200 }} 200w,
                        {{ section.settings.feature_image | image_url: width: 300 }} 300w,
                        {{ section.settings.feature_image | image_url: width: 400 }} 400w"
                sizes="(max-width: 768px) 200px, 300px"
                alt="{{ section.settings.feature_image.alt | default: section.settings.feature_title }}"
                loading="lazy"
              >
            {% else %}
              <div class="image-upload-placeholder" style="min-height: 200px; background-color: #f8fafc; border-radius: 12px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" style="color: #94a3b8;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
                <p style="color: #94a3b8; font-size: 12px; margin-top: 8px;">Upload Feature Image</p>
              </div>
            {% endif %}
          </div>

          {%- comment -%} Text Content {%- endcomment -%}
          <div class="hiw-main-text">
            {% if section.settings.feature_badge != blank %}
              <div class="badge badge-primary" style="margin-bottom: 0.75rem;">
                <span style="width: 6px; height: 6px; background: var(--color-primary); border-radius: 50%; animation: pulse 2s infinite;"></span>
                <span>{{ section.settings.feature_badge }}</span>
              </div>
            {% endif %}
            <h3 class="font-black">{{ section.settings.feature_title }}</h3>
            <h4>{{ section.settings.feature_subtitle }}</h4>
            <p>{{ section.settings.feature_description }}</p>
          </div>
        </div>
      </div>

      {%- comment -%} Steps {%- endcomment -%}
      <div class="hiw-steps">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <div class="hiw-step" {{ block.shopify_attributes }}>
              <div class="hiw-step-content">
                <div class="hiw-step-number">{{ forloop.index }}</div>
                <div class="hiw-step-text">
                  <h5>{{ block.settings.title }}</h5>
                  <p>{{ block.settings.description }}</p>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {%- comment -%} Buttons {%- endcomment -%}
      <div class="flex flex-col gap-3 justify-center items-center" style="margin-bottom: 0.75rem;">
        <div class="flex flex-col gap-3" style="width: 100%; max-width: 500px;">
          {% if section.settings.primary_button_text != blank %}
            <a href="{{ section.settings.primary_button_url }}"
               {% if section.settings.primary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
               class="btn btn-primary btn-lg btn-full">
              {{ section.settings.primary_button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          {% endif %}

          {% if section.settings.secondary_button_text != blank %}
            <a href="{{ section.settings.secondary_button_url }}"
               {% if section.settings.secondary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
               class="btn btn-amazon btn-lg btn-full">
              {{ section.settings.secondary_button_text }}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.settings.disclaimer != blank %}
        <p class="text-muted text-xs text-center">{{ section.settings.disclaimer }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "class": "section-how-it-works",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "How It Works"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Apply <span class=\"text-primary font-semibold\">3–10 sprays</span> to the head and shaft, let it absorb for a few minutes, then enjoy longer-lasting control."
    },
    {
      "type": "header",
      "content": "Main Feature Card"
    },
    {
      "type": "image_picker",
      "id": "feature_image",
      "label": "Feature Image",
      "info": "Recommended: 400x400px (illustration or product image)"
    },
    {
      "type": "text",
      "id": "feature_badge",
      "label": "Feature Badge Text",
      "default": "Active Ingredient"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Feature Title",
      "default": "13% Lidocaine"
    },
    {
      "type": "text",
      "id": "feature_subtitle",
      "label": "Feature Subtitle",
      "default": "Maximum Strength Non-Prescription Formula"
    },
    {
      "type": "textarea",
      "id": "feature_description",
      "label": "Feature Description",
      "default": "Gently numbs surface nerves to calm overstimulation that causes early climax. Helps delay ejaculation while keeping natural sensation and full pleasure."
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Button Text",
      "default": "Shop Valentine's Sale – 25% OFF"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "primary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Button Text",
      "default": "Shop on Amazon"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "secondary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Disclaimer"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "*Discount applied automatically at checkout – no code needed"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Calms Overstimulation"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Gently reduces nerve sensitivity to help delay climax and keep you in control."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works",
      "category": "Informational",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Calms Overstimulation",
            "description": "Gently reduces nerve sensitivity to help delay climax and keep you in control."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Balances Sensation",
            "description": "Lowers sensitivity just enough for endurance without dulling pleasure."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Fast-Acting & Partner-Safe",
            "description": "Absorbs in minutes for quick results with no transfer or residue."
          }
        }
      ]
    }
  ]
}
{% endschema %}
