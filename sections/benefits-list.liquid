{{ 'component-sections.css' | asset_url | stylesheet_tag }}

<section class="benefits-section section-bg-pattern" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};">
  <div class="container">
    <div class="benefits-content">
      {%- comment -%} Header {%- endcomment -%}
      <div class="benefits-header">
        {% if section.settings.badge != blank %}
          <div class="badge badge-primary" style="margin-bottom: 1rem;">
            <span>{{ section.settings.badge }}</span>
          </div>
        {% endif %}
        <h2 class="font-black">{{ section.settings.title }}</h2>
        <p>{{ section.settings.subtitle }}</p>
      </div>

      {%- comment -%} Benefits List {%- endcomment -%}
      <div class="benefits-list">
        {% assign counter = 1 %}
        {% for block in section.blocks %}
          {% if block.type == 'benefit' %}
            <div class="benefit-item" {{ block.shopify_attributes }}>
              <div class="benefit-item-content">
                <div class="benefit-icon">
                  {% case block.settings.icon %}
                    {% when 'clock' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {% when 'heart' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                    {% when 'shield' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                    {% when 'zap' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
                    {% when 'droplet' %}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/></svg>
                  {% endcase %}
                </div>
                <div class="benefit-text">
                  <h3>
                    {{ block.settings.title }}
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </h3>
                  <p>{{ block.settings.description }}</p>
                </div>
                <div class="benefit-number">{{ counter }}</div>
              </div>
            </div>
            {% assign counter = counter | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benefits List",
  "tag": "section",
  "class": "section-benefits",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "Proven Benefits"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What You'll Get"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Science-backed results you can feel"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clock", "label": "Clock" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "zap", "label": "Zap" },
            { "value": "droplet", "label": "Droplet" }
          ],
          "default": "clock"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit Title",
          "default": "Longer-Lasting Performance"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit Description",
          "default": "Extend intimacy – stay in control without rushing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits List",
      "category": "Informational",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "Longer-Lasting Performance",
            "description": "Extend intimacy – stay in control without rushing."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "heart",
            "title": "Natural Feel",
            "description": "You'll still feel everything – it reduces sensitivity, not pleasure."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Clinically Tested & Safe",
            "description": "FDA-compliant formula – trusted for comfort and reliable results."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "zap",
            "title": "Fast-Acting & Simple",
            "description": "Just spray – wait 5–10 minutes – and you're ready."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "droplet",
            "title": "Partner-Safe",
            "description": "No transfer once absorbed – just enjoy longer, more connected intimacy."
          }
        }
      ]
    }
  ]
}
{% endschema %}
