<section class="sale-cta-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};">
  <div class="sale-cta-glow"></div>

  <div class="sale-cta-container">
    <div class="sale-cta-content">
      {% if section.settings.show_badge %}
        <div class="sale-cta-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {% endif %}

      <h2 class="sale-cta-title">{{ section.settings.title }}</h2>

      <div class="sale-cta-box">
        <div class="sale-cta-discount">{{ section.settings.discount_text }}</div>
        <p class="sale-cta-promo">{{ section.settings.promo_text }}</p>
        <p class="sale-cta-subtext">{{ section.settings.promo_subtext }}</p>
      </div>

      <div class="sale-cta-buttons">
        {% if section.settings.primary_button_text != blank %}
          <a href="{{ section.settings.primary_button_url }}"
             {% if section.settings.primary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
             class="sale-cta-btn sale-cta-btn-primary">
            {{ section.settings.primary_button_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_text != blank %}
          <a href="{{ section.settings.secondary_button_url }}"
             {% if section.settings.secondary_button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
             class="sale-cta-btn sale-cta-btn-amazon">
            {{ section.settings.secondary_button_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>

      {% if section.settings.disclaimer != blank %}
        <p class="sale-cta-disclaimer">{{ section.settings.disclaimer }}</p>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .sale-cta-section {
    position: relative;
    overflow: hidden;
  }

  .sale-cta-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse, rgba(59, 130, 246, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .sale-cta-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .sale-cta-container {
      padding: 0 1.5rem;
    }
  }

  .sale-cta-content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .sale-cta-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 1.25rem;
  }

  .sale-cta-title {
    font-size: 2rem;
    font-weight: 900;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    .sale-cta-title {
      font-size: 2.5rem;
    }
  }

  .sale-cta-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .sale-cta-box {
      padding: 2rem;
    }
  }

  .sale-cta-discount {
    font-size: 3rem;
    font-weight: 900;
    color: #EF4444;
    margin-bottom: 0.5rem;
    text-shadow: 0 0 40px rgba(239, 68, 68, 0.5);
  }

  @media (min-width: 768px) {
    .sale-cta-discount {
      font-size: 4rem;
    }
  }

  .sale-cta-promo {
    font-size: 1.125rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0 0 0.25rem;
  }

  @media (min-width: 768px) {
    .sale-cta-promo {
      font-size: 1.25rem;
    }
  }

  .sale-cta-subtext {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .sale-cta-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 480px) {
    .sale-cta-buttons {
      flex-direction: row;
      justify-content: center;
      gap: 1rem;
    }
  }

  .sale-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.75rem;
    transition: all 0.2s ease;
  }

  @media (min-width: 768px) {
    .sale-cta-btn {
      padding: 1rem 2rem;
    }
  }

  .sale-cta-btn-primary {
    background: linear-gradient(135deg, #3B82F6, #2563EB);
    color: #FFFFFF;
  }

  .sale-cta-btn-primary:hover {
    background: linear-gradient(135deg, #2563EB, #1D4ED8);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
  }

  .sale-cta-btn-amazon {
    background: linear-gradient(135deg, #FF9900, #FF8C00);
    color: #0F172A;
  }

  .sale-cta-btn-amazon:hover {
    background: linear-gradient(135deg, #FF8C00, #E67E00);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 153, 0, 0.4);
  }

  .sale-cta-disclaimer {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }
</style>

{% schema %}
{
  "name": "Valentine's Sale CTA",
  "tag": "section",
  "class": "section-sale-cta",
  "settings": [
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Limited Time Offer"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Valentine's Sale"
    },
    {
      "type": "text",
      "id": "discount_text",
      "label": "Discount Text",
      "default": "25% OFF"
    },
    {
      "type": "text",
      "id": "promo_text",
      "label": "Promo Text",
      "default": "No code needed"
    },
    {
      "type": "text",
      "id": "promo_subtext",
      "label": "Promo Subtext",
      "default": "Auto-applied at checkout • Feb 1-14"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_text",
      "label": "Button Text",
      "default": "Shop Valentine's Sale"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "primary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Button Text",
      "default": "Shop on Amazon"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "secondary_button_new_tab",
      "label": "Open in New Tab",
      "default": true
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "*Discount applied automatically at checkout – no code needed"
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#0F172A"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Valentine's Sale CTA",
      "category": "CTA"
    }
  ]
}
{% endschema %}
