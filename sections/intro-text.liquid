    {
      "type": "checkbox",
      "id": "show_bottom_gradient",
      "label": "Show Bottom Gradient",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Intro Text",
      "category": "Text"
    }
  ]
}
{% endschema %}
