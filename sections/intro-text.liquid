{{ 'component-sections.css' | asset_url | stylesheet_tag }}

<section class="intro-section" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background-color: {{ section.settings.background_color }};">
  {% if section.settings.show_left_accent %}
    <div class="intro-left-accent" style="position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 0.25rem; height: 8rem; background: linear-gradient(to bottom, transparent, {{ section.settings.accent_color | default: 'rgba(59, 130, 246, 0.3)' }}, transparent);"></div>
  {% endif %}

  <div class="container">
    <div class="intro-content" style="max-width: {{ section.settings.content_width }}px;">
      <div class="relative">
        {% if section.settings.show_top_divider %}
          <div class="intro-divider"></div>
        {% endif %}

        <h2 class="intro-title font-black" style="margin-bottom: {{ section.settings.title_spacing }}px;">
          <span style="display: block; color: {{ section.settings.title_line_1_color }}; font-size: {{ section.settings.title_line_1_size_mobile }}px;">{{ section.settings.title_line_1 }}</span>
          <span style="display: block; color: {{ section.settings.title_line_2_color }};">{{ section.settings.title_line_2 }}</span>
        </h2>

        {% if section.settings.description != blank %}
          <p class="intro-description" style="color: {{ section.settings.description_color }}; font-size: {{ section.settings.description_size }}px;">
            {{ section.settings.description }}
          </p>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.settings.show_bottom_gradient %}
    <div class="intro-gradient"></div>
  {% endif %}
</section>

<style>
  @media (min-width: 768px) {
    .intro-title span:first-child {
      font-size: {{ section.settings.title_line_1_size_desktop }}px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Intro Text",
  "tag": "section",
  "class": "section-intro",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Want to Last Longer?"
    },
    {
      "type": "color",
      "id": "title_line_1_color",
      "label": "Title Line 1 Color",
      "default": "#0F172A"
    },
    {
      "type": "range",
      "id": "title_line_1_size_mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title Line 1 Size (Mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "title_line_1_size_desktop",
      "min": 28,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Title Line 1 Size (Desktop)",
      "default": 48
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2",
      "default": "You're Not Alone."
    },
    {
      "type": "color",
      "id": "title_line_2_color",
      "label": "Title Line 2 Color",
      "default": "#3B82F6"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Title Bottom Spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Millions of men experience early ejaculation but few talk about it. Dynamo Delay Spray is a simple topical solution that helps reduce sensitivity just enough to stay in control without losing pleasure or confidence."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#64748B"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description Font Size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "label": "Content Max Width",
      "default": 700
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 65
    },
    {
      "type": "header",
      "content": "Decorative Elements"
    },
    {
      "type": "checkbox",
      "id": "show_left_accent",
      "label": "Show Left Accent Line",
      "default": true
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#3B82F6"
    },
    {
      "type": "checkbox",
      "id": "show_top_divider",
      "label": "Show Top Divider",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bottom_gradient",
      "label": "Show Bottom Gradient",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Intro Text",
      "category": "Text"
    }
  ]
}
{% endschema %}
